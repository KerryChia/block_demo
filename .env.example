# ===== LLM 网关配置（OpenAI 兼容 /v1/chat/completions）=====
# 任何 OpenAI 兼容网关都可以：DeepSeek 官方、CLIProxyAPI、OneAPI 等
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# 离线演示模式：不调真实大模型，用内置脚本 agent（活动当天断网兜底 / 本地开发）
MOCK_LLM=0

# 服务
HOST=0.0.0.0
PORT=8300
DATA_DIR=./data
